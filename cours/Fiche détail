@import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');

:root{
  /* ---- neutres (charte Comptaflow : slate + blue-50) ---- */
  --paper:#EFF6FF;      /* blue-50, fond du site */
  --card:#ffffff;
  --paper-2:#F1F5F9;    /* slate-100 */
  --ink:#0F172A;        /* slate-900 */
  --ink-2:#1E293B;      /* slate-800 */
  --ink-soft:#64748B;   /* slate-500 */
  --ink-faint:#94A3B8;  /* slate-400 */
  --line:#DBEAFE;       /* blue-100 */
  --line-2:#E2E8F0;     /* slate-200 */

  /* ---- marque ---- */
  --blue:#3B82F6; --blue-600:#2563EB; --blue-700:#1D4ED8; --navy:#1E40AF; --navy-deep:#0F2137;
  --teal:#14B8A6; --teal-400:#2DD4BF; --teal-600:#0D9488; --teal-700:#0F766E;

  /* ---- accents par partie ---- */
  --c1:#2563EB; --c1-ink:#1E40AF; --c1-bg:#EFF6FF; --c1-bg2:#DBEAFE;   /* I  Â· bleu  */
  --c2:#0D9488; --c2-ink:#0F766E; --c2-bg:#F0FDFA; --c2-bg2:#CCFBF1;   /* II Â· teal  */
  --c3:#7C3AED; --c3-ink:#6D28D9; --c3-bg:#F5F3FF; --c3-bg2:#EDE9FE;   /* IIIÂ· violet */

  /* ---- alerte / juridique ---- */
  --red:#DC2626; --red-bg:#FEF2F2; --red-border:#FECACA;

  --shadow:0 1px 2px rgba(15,23,42,.04), 0 8px 24px -14px rgba(30,64,175,.22);
  --radius:16px;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--paper);color:var(--ink-2);
  font-family:'Inter',system-ui,-apple-system,sans-serif;
  font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;
}
.wrap{max-width:920px;margin:0 auto;padding:32px 22px 96px}

/* ---------- typographie ---------- */
h1,h2,h3,.eyebrow,.folio{font-family:'Bricolage Grotesque',sans-serif}
.mono{font-family:'Space Mono',monospace}
h2{font-size:1.55rem;font-weight:800;letter-spacing:-.01em;margin:0}
h3{font-size:1.12rem;font-weight:700;margin:0 0 .35em;color:var(--ink)}
p{margin:0 0 .8em}
strong{font-weight:700}

/* ---------- header ---------- */
.masthead{
  border:1px solid var(--line);border-radius:var(--radius);background:var(--card);
  padding:28px 28px 24px;position:relative;overflow:hidden;box-shadow:var(--shadow);
}
.masthead::before{
  content:"";position:absolute;top:0;left:0;right:0;height:7px;
  background:linear-gradient(90deg,var(--c1) 0 33.3%,var(--c2) 33.3% 66.6%,var(--c3) 66.6% 100%);
}
.eyebrow{
  display:inline-flex;gap:10px;align-items:center;margin-top:8px;
  font-size:.74rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);
}
.eyebrow .tag{background:var(--navy);color:var(--teal-400);padding:3px 10px;border-radius:7px;letter-spacing:.1em}
.masthead h1{
  font-weight:800;letter-spacing:-.02em;font-size:clamp(2.1rem,6vw,3.1rem);
  line-height:1.04;margin:.3em 0 .12em;color:var(--ink);
}
.masthead h1 em{font-style:normal;color:var(--blue)}
.subtitle{color:var(--ink-soft);font-size:1.02rem;max-width:52ch;margin:0}
.keywords{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.chip{
  font-size:.8rem;font-weight:600;padding:5px 12px;border-radius:999px;
  background:var(--c1-bg);border:1px solid var(--line);color:var(--blue-700);
}

/* intitulÃ© vocabulaire */
.vocab{margin-top:22px}
.vocab-lbl{font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:10px;display:flex;align-items:center;gap:8px}
.vocab-lbl svg{width:15px;height:15px;color:var(--blue)}

/* lien "ultra condensÃ©" (chrono) */
.express-link{
  display:inline-flex;align-items:center;gap:13px;margin-top:20px;text-decoration:none;
  background:var(--navy-deep);color:#fff;border-radius:13px;padding:11px 16px 11px 13px;
  box-shadow:var(--shadow);transition:transform .16s,background .16s;
}
.express-link:hover{transform:translateY(-2px);background:#132a49}
.express-link:focus-visible{outline:3px solid var(--teal-400);outline-offset:2px}
.express-link .ico-chrono{width:30px;height:30px;color:var(--teal-400);flex:none}
.express-link .el-txt{display:flex;flex-direction:column;line-height:1.2}
.express-link .el-t{font-family:'Bricolage Grotesque';font-weight:800;font-size:1.05rem}
.express-link .el-s{font-size:.76rem;color:#a9c4ee;font-weight:600;margin-top:1px}
.express-link .el-arrow{margin-left:4px;font-weight:800;color:var(--teal-400);transition:transform .16s}
.express-link:hover .el-arrow{transform:translateX(3px)}

/* section ultra condensÃ© */
.express{margin-top:24px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:22px 24px;position:relative;overflow:hidden;scroll-margin-top:16px}
.express::before{content:"";position:absolute;top:0;left:0;right:0;height:5px;background:var(--navy-deep)}
.express-head{display:flex;align-items:center;gap:15px;margin-bottom:16px;flex-wrap:wrap}
.chrono-big{width:54px;height:54px;flex:none;background:var(--c1-bg);border:1px solid var(--line);border-radius:14px;padding:11px;color:var(--navy)}
.express-head .lbl{font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
.express-head h2{color:var(--navy);font-size:1.5rem}
.time-badge{margin-left:auto;display:inline-flex;align-items:center;gap:7px;background:var(--navy-deep);color:#fff;font-weight:700;font-size:.82rem;padding:7px 13px;border-radius:999px}
.time-badge svg{width:15px;height:15px;color:var(--teal-400)}
.express > p.lede{color:var(--ink-soft);font-size:.95rem;margin:-4px 0 16px}
.express-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.ex-col{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff}
.ex-col h4{margin:0;padding:9px 13px;font-family:'Bricolage Grotesque';font-weight:700;font-size:.9rem;color:#fff;display:flex;align-items:center;gap:7px}
.ex-col.b1 h4{background:var(--c1)} .ex-col.b2 h4{background:var(--c2)} .ex-col.b3 h4{background:var(--c3)}
.ex-col ul{margin:0;padding:11px 13px 13px 26px;font-size:.83rem;line-height:1.5}
.ex-col li{margin-bottom:7px}
.ex-col li:last-child{margin-bottom:0}
.ex-col b{font-weight:700;color:var(--ink)}
.ex-dates{font-family:'Space Mono';font-size:.78rem;font-weight:700;color:var(--c2-ink)}

/* ---------- l'essentiel ---------- */
.tldr{
  margin:22px 0 6px;border-radius:var(--radius);background:var(--navy-deep);
  color:#dbeafe;padding:22px 24px;box-shadow:var(--shadow);position:relative;overflow:hidden;
}
.tldr::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--teal-400)}
.tldr h3{color:#fff;display:flex;align-items:center;gap:9px;font-size:.9rem;text-transform:uppercase;letter-spacing:.09em}
.tldr p{color:#cdd9ee;margin:0}
.tldr .k{color:var(--teal-400);font-weight:700}

/* ---------- sommaire ---------- */
.toc{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:22px 0 8px}
.toc a{text-decoration:none;border-radius:14px;padding:16px;display:block;background:var(--card);border:1px solid var(--line);border-top:3px solid;transition:.18s}
.toc a:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.toc .n{font-family:'Bricolage Grotesque';font-weight:800;font-size:1.4rem;line-height:1}
.toc .t{display:block;font-weight:600;margin-top:8px;font-size:.92rem;color:var(--ink-2)}
.toc a.p1{border-top-color:var(--c1)} .toc a.p1 .n{color:var(--c1)}
.toc a.p2{border-top-color:var(--c2)} .toc a.p2 .n{color:var(--c2)}
.toc a.p3{border-top-color:var(--c3)} .toc a.p3 .n{color:var(--c3)}

/* ---------- sections ---------- */
section{margin-top:48px;scroll-margin-top:16px}
.sec-head{display:flex;align-items:center;gap:16px;margin-bottom:20px}
.folio{flex:none;width:52px;height:52px;border-radius:14px;display:grid;place-items:center;font-weight:800;font-size:1.6rem;color:#fff;box-shadow:var(--shadow)}
.folio.p1{background:var(--c1)} .folio.p2{background:var(--c2)} .folio.p3{background:var(--c3)}
.sec-head .lbl{font-size:.72rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)}
.p1 h2{color:var(--c1-ink)} .p2 h2{color:var(--c2-ink)} .p3 h2{color:var(--c3-ink)}

.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:22px 24px;margin-bottom:18px;box-shadow:var(--shadow)}
.card > h3:first-child{margin-top:0}
.sub{font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin:2px 0 12px}
.p1 .sub{color:var(--c1)} .p2 .sub{color:var(--c2)} .p3 .sub{color:var(--c3)}

/* dÃ©finitions */
.def{border-left:4px solid var(--c1);background:var(--c1-bg);padding:14px 18px;border-radius:0 12px 12px 0;margin:0 0 14px}
.def .tag{font-family:'Space Mono';font-size:.72rem;font-weight:700;color:var(--c1-ink);text-transform:uppercase;letter-spacing:.05em}
.def.official{border-color:var(--navy);background:var(--c1-bg2)}
.def.official .tag{color:var(--navy)}
.def p{margin:.35em 0 0}
.ref{font-family:'Space Mono';font-size:.82rem;font-weight:700;color:var(--red);white-space:nowrap}

/* ---------- callouts ---------- */
.callout{border-radius:12px;padding:14px 16px 14px 18px;margin:14px 0;font-size:.95rem;border:1px solid var(--line-2);border-left-width:4px;background:#fff}
.callout .h{font-weight:700;display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:.92rem}
.callout p:last-child{margin-bottom:0}
.clair{border-left-color:var(--c3);background:var(--c3-bg)}   .clair .h{color:var(--c3-ink)}
.retenir{border-left-color:var(--navy);background:var(--c1-bg)} .retenir .h{color:var(--navy)}
.piege{border-left-color:var(--red);background:var(--red-bg)}  .piege .h{color:var(--red)}
.cours{border-left-color:var(--c2);background:var(--c2-bg)}    .cours .h{color:var(--c2-ink)}

/* ---------- flow systÃ¨me ---------- */
.flow{display:flex;flex-direction:column;gap:6px;margin:8px 0 6px}
.flow-row{display:flex;gap:10px;align-items:stretch}
.flow-step{flex:1;color:#fff;border-radius:12px;padding:14px 12px;text-align:center;font-weight:700;font-size:.92rem;display:flex;align-items:center;justify-content:center;min-height:64px;background:var(--navy)}
.flow-step:nth-child(3){background:var(--blue-600)}
.flow-step:nth-child(5){background:var(--blue)}
.flow-arrow{align-self:center;color:var(--blue);font-size:1.4rem;font-weight:800;flex:none}
.flow-io{display:flex;justify-content:space-between;gap:10px;margin-top:4px}
.flow-io span{flex:1;text-align:center;background:var(--c1-bg);color:var(--c1-ink);border:1px dashed var(--blue);border-radius:10px;padding:9px;font-size:.82rem;font-weight:700}
.flow-io .mid{align-self:center;color:var(--blue);font-weight:800;border:none;background:none}

/* ---------- tableaux ---------- */
.tbl-wrap{overflow-x:auto;border-radius:12px;border:1px solid var(--line);margin:6px 0}
table{border-collapse:collapse;width:100%;font-size:.9rem;min-width:520px}
th,td{padding:11px 13px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
thead th{background:var(--navy-deep);color:#e2ecff;font-weight:600;font-size:.82rem}
tbody tr:last-child td{border-bottom:none}
tbody tr:nth-child(even){background:var(--c1-bg)}
.rowhead{font-weight:700;color:var(--ink);background:var(--paper-2)!important;white-space:nowrap}
.tag-oblig{color:var(--red);font-weight:700}
.tag-fac{color:var(--ink-soft);font-weight:600}

.role-grid{display:grid;grid-template-columns:190px 1fr;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.role-grid > div{padding:12px 15px;border-bottom:1px solid var(--line)}
.role-grid .k{background:var(--c1-bg);font-weight:700;font-size:.9rem}
.role-grid .k b{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--c1);font-weight:800;margin-bottom:2px}
.role-grid > div:nth-last-child(-n+2){border-bottom:none}

/* ---------- svg ---------- */
.svgbox{width:100%;margin:6px 0}
.svgbox svg{width:100%;height:auto;display:block}

/* ---------- confluence droit ---------- */
.confluence{margin:10px 0}
.hub-node{text-align:center;font-weight:800;color:#fff;background:var(--c2);border-radius:12px;padding:12px;max-width:280px;margin:0 auto 4px;font-family:'Bricolage Grotesque';letter-spacing:.01em}
.branches{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}
.branch{border:1.5px solid var(--c2);border-radius:12px;overflow:hidden;background:var(--card)}
.branch h4{margin:0;background:var(--c2-bg);color:var(--c2-ink);padding:10px 12px;font-size:.92rem;font-family:'Bricolage Grotesque';font-weight:700;border-bottom:1.5px solid var(--c2)}
.branch ul{margin:0;padding:10px 12px 12px 26px;font-size:.85rem}
.branch li{margin-bottom:6px}

/* ---------- timeline ---------- */
.timeline{position:relative;margin:8px 0 0;padding-left:8px}
.timeline::before{content:"";position:absolute;left:118px;top:6px;bottom:6px;width:2px;background:var(--c2-bg2)}
.tl-row{display:grid;grid-template-columns:108px 1fr;position:relative;padding:7px 0}
.tl-date{font-family:'Space Mono';font-weight:700;font-size:.82rem;color:var(--c2-ink);text-align:right;padding-right:22px;padding-top:1px}
.tl-body{padding-left:22px;position:relative}
.tl-body::before{content:"";position:absolute;left:-5px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--card);border:2.5px solid var(--c2)}
.tl-row.key .tl-body::before{background:var(--red);border-color:var(--red)}
.tl-row.key .tl-date{color:var(--red)}
.tl-tag{display:inline-block;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;background:var(--red-bg);color:var(--red);padding:1px 7px;border-radius:5px;margin-left:6px}
.sources{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.sources .src{font-size:.82rem;font-weight:600;background:var(--c2-bg);color:var(--c2-ink);border:1px solid var(--c2-bg2);padding:6px 12px;border-radius:8px}

/* ---------- mÃ©tiers ---------- */
.ladder{display:flex;flex-direction:column;gap:10px}
.job{display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:start;border:1px solid var(--line);border-left:5px solid var(--c3);border-radius:12px;padding:14px 16px;background:var(--card)}
.job .lvl{font-family:'Bricolage Grotesque';font-weight:800;font-size:1.3rem;color:var(--c3);line-height:1;padding-top:2px}
.job h4{margin:0 0 3px;font-size:1rem;font-family:'Bricolage Grotesque';font-weight:700}
.job p{margin:0;font-size:.9rem;color:var(--ink-soft)}
.job .badge{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--c3-ink);background:var(--c3-bg2);padding:2px 8px;border-radius:5px;margin-left:8px;vertical-align:middle}

.vs{display:grid;grid-template-columns:1fr 1fr;border:1.5px solid var(--c3);border-radius:12px;overflow:hidden;margin-top:6px}
.vs > div{padding:14px 16px}
.vs .l{border-right:1.5px solid var(--c3);background:var(--c3-bg)}
.vs h5{margin:0 0 8px;font-family:'Bricolage Grotesque';font-weight:800;font-size:1rem;color:var(--c3-ink)}
.vs ul{margin:0;padding-left:18px;font-size:.87rem}
.vs li{margin-bottom:5px}

/* ---------- footer ---------- */
.footer{margin-top:56px;border-top:2px solid var(--navy);padding-top:16px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:.82rem;color:var(--ink-soft)}
.footer .mono{font-weight:700;color:var(--navy)}

/* ---------- responsive ---------- */
@media(max-width:640px){
  .toc{grid-template-columns:1fr}
  .branches{grid-template-columns:1fr}
  .role-grid{grid-template-columns:1fr}
  .role-grid .k{border-bottom:none}
  .vs{grid-template-columns:1fr}
  .vs .l{border-right:none;border-bottom:1.5px solid var(--c3)}
  .flow-row{flex-direction:column}
  .flow-arrow{transform:rotate(90deg)}
  .timeline::before{left:96px}
  .tl-row{grid-template-columns:86px 1fr}
}
@media print{
  body{background:#fff}
  .card,.masthead,.tldr{box-shadow:none}
  section{break-inside:avoid}
  .toc a:hover{transform:none}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}

/* ===== Chrome partagÃ© Comptaflow (nav / fil d'ariane / navigation fiches) ===== */
nav.cf{position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 40px;height:60px;background:#fff;border-bottom:1px solid var(--line)}
nav.cf .logo{display:flex;align-items:center;gap:10px;text-decoration:none}
nav.cf .logo-mark{width:32px;height:32px;border-radius:8px;background:var(--navy);display:flex;align-items:center;justify-content:center;color:var(--teal-400);font-size:18px;font-weight:700;font-family:'Bricolage Grotesque',sans-serif}
nav.cf .logo-name{font-size:17px;font-weight:600;color:var(--ink)}
nav.cf .logo-name span{color:var(--blue)}
nav.cf .back-link{font-size:14px;color:var(--ink-soft);text-decoration:none}
nav.cf .back-link:hover{color:var(--ink)}
.breadcrumb{font-size:13px;color:var(--ink-faint);margin-bottom:18px}
.breadcrumb a{color:var(--teal-600);text-decoration:none}
.breadcrumb a:hover{text-decoration:underline}
.fiche-nav{display:flex;justify-content:space-between;gap:12px;margin-top:28px}
.fiche-nav .nav-btn{flex:1;background:#fff;border:1px solid var(--line);border-radius:10px;padding:13px 16px;font-size:13px;color:var(--ink-2);text-decoration:none;font-weight:500;transition:border-color .15s,background .15s}
.fiche-nav .nav-btn:hover{border-color:var(--blue);background:var(--c1-bg)}
.fiche-nav .nav-btn.next{text-align:right}
.fiche-nav .nav-btn.disabled{opacity:.4;pointer-events:none}
@media(max-width:640px){nav.cf{padding:0 20px}}
